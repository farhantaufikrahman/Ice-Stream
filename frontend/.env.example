# Salin menjadi .env.local jika perlu mengubah nilai default (file .local
# tidak ikut di-commit). Semua nilai di bawah ini adalah default-nya.

# Alamat Gateway Kubernetes (ice-stream-gateway, port 4000) yang dituju
# proxy Vite untuk path /api.
API_PROXY_TARGET=http://127.0.0.1:4000
# Header Host yang dipakai Gateway untuk memilih HTTPRoute API.
API_PROXY_HOST=api.ice-stream.localhost

# Alamat API yang dipanggil browser. Biarkan /api/v1 (lewat proxy di atas).
VITE_API_BASE_URL=/api/v1
