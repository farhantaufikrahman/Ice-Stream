# Salin file ini menjadi .env lalu sesuaikan isinya: cp .env.example .env
APP_ENV=development
HTTP_PORT=8080
# Pisahkan dengan koma jika lebih dari satu domain
CORS_ALLOWED_ORIGINS=http://localhost:5173
SHUTDOWN_TIMEOUT=10s

# Koneksi Oracle untuk `make run` (butuh `make k8s-forward-db` di terminal lain)
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=FREEPDB1
DB_USER=auth_svc
# Samakan dengan AUTH_SVC_PASSWORD di infra/k8s/secrets/oracle.env
DB_PASSWORD=ganti-password-auth

# Username Docker Hub, dipakai Makefile untuk nama image
DOCKERHUB_USER=ganti-username-dockerhub