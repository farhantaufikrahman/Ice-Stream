# Contoh isi .env untuk menjalankan service di laptop (make run, make
# run-auth, make run-video, make run-transcoder).
#
#   cp .env.example .env    lalu isi baris yang ditandai WAJIB.
#
# .env TIDAK BOLEH di-commit (sudah ada di .gitignore). Baris yang dibiarkan
# kosong memakai nilai default yang tertulis di komentar. Di Kubernetes
# nilai-nilai ini datang dari ConfigMap (infra/k8s/*/configmap.yaml) dan
# Secret (infra/k8s/secrets/*.env), bukan dari file ini.

# ---------- Umum (semua service) ----------
# development | production. Default: development
APP_ENV=
# Batas waktu menunggu request selesai saat service dimatikan. Default: 10s
SHUTDOWN_TIMEOUT=
# Akun Docker Hub untuk nama image (make docker-build, docker-push). WAJIB untuk build image.
DOCKERHUB_USER=

# ---------- API gateway (cmd/api) ----------
# Default: 8080
HTTP_PORT=
# Origin frontend, pisahkan dengan koma. Default: http://localhost:5173
CORS_ALLOWED_ORIGINS=
# IP/CIDR proxy yang boleh mengisi X-Forwarded-For. Kosong = header itu
# diabaikan (paling aman jika gateway diakses langsung). Di Kubernetes: 10.0.0.0/8.
TRUSTED_PROXIES=
# Alamat AuthService dan VideoService. Default: localhost:50051 dan localhost:50052
AUTH_GRPC_ADDR=
VIDEO_GRPC_ADDR=
# WAJIB. File kunci publik JWT, misalnya secrets/jwt-public.pem
JWT_PUBLIC_KEY_FILE=
# Cookie refresh token. Default Secure: true di production, false di development. SameSite default: lax
COOKIE_SECURE=
COOKIE_SAMESITE=
# Batas penonton danmaku/chat live per pod gateway. Default: 5000
LIVE_MAX_CLIENTS=
# Langkah 28: rate limit login, upload, komentar, danmaku, chat, laporan. Default: true
RATE_LIMIT_ENABLED=
# Langkah 29: true = hanya admin yang boleh siaran (dipakai versi online
# lewat Cloudflare Tunnel). Default: false
LIVE_BROADCAST_ADMIN_ONLY=
# Login Google/GitHub (langkah 26). Kosong = tombolnya tidak tampil.
APP_BASE_URL=
OAUTH_REDIRECT_BASE_URL=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ---------- Port /metrics Prometheus (langkah 28) ----------
# Sengaja TIDAK diisi di sini: .env dipakai bersama oleh semua service,
# jadi satu nilai membuat port-nya bentrok. Default-nya sudah berbeda:
# gateway 9090, AuthService 9091, VideoService 9092, transcoder ikut port
# HTTP-nya (GET /metrics).
# METRICS_PORT=

# ---------- AuthService dan VideoService (cmd/auth, cmd/video) ----------
# Default GRPC_PORT: 50051 (auth). make run-video memakai 50052.
GRPC_PORT=
# Oracle. Default: localhost:1521, service FREEPDB1. Butuh make k8s-forward-db.
DB_HOST=
DB_PORT=
DB_SERVICE=
# Default: auth_svc (AuthService) / video_svc (VideoService)
DB_USER=
# WAJIB. Password auth_svc (AuthService)
DB_PASSWORD=
# WAJIB untuk make run-video. Password video_svc
VIDEO_DB_PASSWORD=
# Default: 10
DB_MAX_OPEN_CONNS=
# WAJIB untuk AuthService. File kunci privat JWT, misalnya secrets/jwt-private.pem
JWT_PRIVATE_KEY_FILE=
# Default: 15m dan 720h
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=
# Email "Lupa kata sandi?". Default: localhost:1025 (Mailpit), 30m
SMTP_ADDR=
MAIL_FROM=
PASSWORD_RESET_TTL=
# Langkah 29: none (Mailpit) | starttls (port 587) | tls (port 465). Default: none
# Resend: SMTP_ADDR=smtp.resend.com:465, SMTP_TLS=tls, SMTP_USERNAME=resend,
# SMTP_PASSWORD=API key Resend. Kosong = tanpa login (Mailpit).
SMTP_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------- Storage RustFS (auth, video, transcoder) ----------
# WAJIB. Sama dengan isi infra/k8s/secrets/storage.env
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Default: http://localhost:9000. Butuh make k8s-forward-storage.
STORAGE_ENDPOINT=
# Alamat storage yang dibuka browser (URL upload). Default: sama dengan STORAGE_ENDPOINT
STORAGE_PUBLIC_ENDPOINT=
# Default: us-east-1, bucket videos (auth memakai images lewat make run-auth)
STORAGE_REGION=
STORAGE_BUCKET=
# Alamat publik file media (HLS, thumbnail, foto profil)
MEDIA_PUBLIC_URL=

# ---------- VideoService (cmd/video) ----------
# Default: 2048 MB, 15m, 1h, 30m
MAX_UPLOAD_MB=
UPLOAD_URL_TTL=
PLAYBACK_URL_TTL=
VIEW_DEDUP_WINDOW=
# NATS (juga dipakai gateway dan transcoder). Default: nats://localhost:4222
NATS_URL=
# Siaran langsung (MediaMTX). Default: http://localhost:9997, :9996, port hook 8090
MEDIAMTX_API_URL=
MEDIAMTX_PLAYBACK_URL=
LIVE_HOOK_PORT=
LIVE_INGEST_URL=
LIVE_PLAYBACK_URL=
LIVE_WHIP_URL=
LIVE_PUBLISH_TOKEN_TTL=
LIVE_POLL_INTERVAL=
LIVE_GRACE=

# ---------- Transcoder (cmd/transcoder) ----------
# Default: folder temp sistem, veryfast, 2 thread, 1h
WORK_DIR=
FFMPEG_PRESET=
FFMPEG_THREADS=
JOB_TIMEOUT=
