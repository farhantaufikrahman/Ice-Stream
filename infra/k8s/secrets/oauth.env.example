# Kredensial "Masuk dengan Google / GitHub" (langkah 26) untuk API gateway.
# Salin menjadi secrets/oauth.env (file itu TIDAK di-commit), lalu isi.
# Penyedia yang dibiarkan kosong dimatikan: tombolnya tidak muncul.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
