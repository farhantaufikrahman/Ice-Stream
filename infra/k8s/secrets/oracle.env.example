# Salin file ini menjadi oracle.env (di folder yang sama) lalu ganti passwordnya:
#   cp oracle.env.example oracle.env
# oracle.env TIDAK di-commit (sudah ada di .gitignore).
# Password: diawali huruf, hanya huruf dan angka, minimal 8 karakter.

# Password user SYS/SYSTEM (admin Oracle). Jarang dipakai aplikasi.
ORACLE_PASSWORD=ganti-password-admin
# Password user AUTH_SVC, dipakai API dan migrasi Flyway.
AUTH_SVC_PASSWORD=ganti-password-auth